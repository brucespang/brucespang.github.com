---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"{% if site.lang %} xml:lang="{{ site.lang }}"{% endif %}>
  <generator uri="http://jekyllrb.com" version="{{ jekyll.version }}">Jekyll</generator>
  {% assign feed_path = "/feed.xml" %}
  {% if site.feed and site.feed.path %}
    {% assign feed_path = site.feed.path %}
  {% endif %}
  <link href="{{ feed_path | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" {% if site.lang %}hreflang="{{ site.lang }}" {% endif %}/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url | xml_escape }}</id>

  {% if site.title %}
    <title type="html">{{ site.title | smartify | xml_escape }}</title>
  {% elsif site.name %}
    <title type="html">{{ site.name | smartify | xml_escape }}</title>
  {% endif %}

  {% if site.description %}
    <subtitle>{{ site.description | xml_escape }}</subtitle>
  {% endif %}

  {% if site.author %}
    <author>
        <name>{{ site.author.name | default: site.author | xml_escape }}</name>
      {% if site.author.email %}
        <email>{{ site.author.email | xml_escape }}</email>
      {% endif %}
      {% if site.author.uri %}
        <uri>{{ site.author.uri | xml_escape }}</uri>
      {% endif %}
    </author>
  {% endif %}

  {%- comment -%}
    Build a single delimited string of YYYY-MM-DD::TYPE::INDEX keys across all
    content types, then split-sort-reverse to interleave them in newest-first
    chronological order. Liquid sorts strings alphabetically; ISO-prefixed
    keys therefore sort chronologically.
  {%- endcomment -%}
  {% assign keys_str = "" %}
  {% for post in site.posts %}{% unless post.draft %}{% capture k %}{{ post.date | date: '%Y-%m-%d' }}::post::{{ forloop.index0 }}|{% endcapture %}{% assign keys_str = keys_str | append: k %}{% endunless %}{% endfor %}
  {% for pub in site.data.publications %}{% capture k %}{{ pub.date | date: '%Y-%m-%d' }}::publication::{{ forloop.index0 }}|{% endcapture %}{% assign keys_str = keys_str | append: k %}{% endfor %}
  {% for talk in site.data.talks %}{% capture k %}{{ talk.date | date: '%Y-%m-%d' }}::talk::{{ forloop.index0 }}|{% endcapture %}{% assign keys_str = keys_str | append: k %}{% endfor %}
  {% for project in site.data.projects %}{% capture k %}{{ project.date | date: '%Y-%m-%d' }}::project::{{ forloop.index0 }}|{% endcapture %}{% assign keys_str = keys_str | append: k %}{% endfor %}
  {% assign feed_keys = keys_str | split: "|" | sort | reverse %}

  {% for key in feed_keys limit: 50 %}{% unless key == "" %}
    {% assign parts = key | split: "::" %}
    {% assign idx = parts[2] | plus: 0 %}

    {% if parts[1] == "post" %}
      {% assign post = site.posts[idx] %}
    <entry{% if post.lang %} xml:lang="{{ post.lang }}"{% endif %}>
      {% if post.external-url %}
      <title type="html">{{ post.title | append: " &rarr;" | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      {% else %}
      <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      {% endif %}
      <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      <id>{{ post.id | absolute_url | xml_escape }}</id>
      <category term="post" />
      <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>

      {% assign post_author = post.author | default: post.authors[0] | default: site.author %}
      {% assign post_author = site.data.authors[post_author] | default: post_author %}
      {% assign post_author_email = post_author.email | default: nil %}
      {% assign post_author_uri = post_author.uri | default: nil %}
      {% assign post_author_name = post_author.name | default: post_author %}

      {% if post_author %}
        <author>
            <name>{{ post_author_name | xml_escape }}</name>
          {% if post_author_email %}
            <email>{{ post_author_email | xml_escape }}</email>
          {% endif %}
          {% if post_author_uri %}
            <uri>{{ post_author_uri | xml_escape }}</uri>
          {% endif %}
        </author>
      {% endif %}

      {% for category in post.categories %}
        <category term="{{ category | xml_escape }}" />
      {% endfor %}

      {% for tag in post.tags %}
        <category term="{{ tag | xml_escape }}" />
      {% endfor %}

      {% if post.excerpt and post.excerpt != empty %}
        <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
      {% endif %}

      {% assign post_image = post.twitter_card.image | default: post.facebook.image %}
      {% if post_image %}
        {% unless post_image contains "://" %}
          {% assign post_image = post_image | absolute_url | xml_escape  %}
        {% endunless %}
        <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post_image }}" />
      {% endif %}
    </entry>

    {% elsif parts[1] == "publication" %}
      {% assign pub = site.data.publications[idx] %}
      {% assign pub_url = nil %}
      {% for link in pub.links limit: 1 %}{% assign pub_url = link[1] %}{% endfor %}
      {% capture pub_content %}<p><strong>{{ pub.venue }}</strong>, {{ pub.date }}</p>{% if pub.authors %}<p>{{ pub.authors | join: ", " }}</p>{% endif %}{% if pub.prize %}<p><em>{{ pub.prize.name }}</em></p>{% endif %}{% if pub.note %}<p>({{ pub.note }})</p>{% endif %}{% if pub.links %}<ul>{% for link in pub.links %}<li><a href="{{ link[1] | absolute_url }}">{{ link[0] }}</a></li>{% endfor %}</ul>{% endif %}{% endcapture %}
    <entry>
      <title type="html">{{ pub.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      {% if pub_url %}
      <link href="{{ pub_url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ pub.title | xml_escape }}" />
      <id>{{ pub_url | absolute_url | xml_escape }}</id>
      {% else %}
      <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ pub.title | xml_escape }}" />
      <id>{{ pub.title | slugify | prepend: "/feed/publication/" | absolute_url | xml_escape }}</id>
      {% endif %}
      <published>{{ pub.date | date_to_xmlschema }}</published>
      <updated>{{ pub.date | date_to_xmlschema }}</updated>
      <category term="publication" />
      <content type="html">{{ pub_content | strip | xml_escape }}</content>
      {% if site.author %}
      <author>
          <name>{{ site.author.name | default: site.author | xml_escape }}</name>
        {% if site.author.email %}
          <email>{{ site.author.email | xml_escape }}</email>
        {% endif %}
      </author>
      {% endif %}
    </entry>

    {% elsif parts[1] == "talk" %}
      {% assign talk = site.data.talks[idx] %}
      {% assign talk_url = nil %}
      {% for link in talk.links limit: 1 %}{% assign talk_url = link[1] %}{% endfor %}
      {% capture talk_content %}<p><strong>Talk at {{ talk.venue }}</strong>, {{ talk.date }}</p>{% if talk.links %}<ul>{% for link in talk.links %}<li><a href="{{ link[1] | absolute_url }}">{{ link[0] }}</a></li>{% endfor %}</ul>{% endif %}{% endcapture %}
    <entry>
      <title type="html">{{ talk.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      {% if talk_url %}
      <link href="{{ talk_url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ talk.title | xml_escape }}" />
      <id>{{ talk_url | absolute_url | xml_escape }}</id>
      {% else %}
      <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ talk.title | xml_escape }}" />
      {% capture talk_id_path %}{{ talk.title }}-{{ talk.venue }}{% endcapture %}
      <id>{{ talk_id_path | slugify | prepend: "/feed/talk/" | absolute_url | xml_escape }}</id>
      {% endif %}
      <published>{{ talk.date | date_to_xmlschema }}</published>
      <updated>{{ talk.date | date_to_xmlschema }}</updated>
      <category term="talk" />
      <content type="html">{{ talk_content | strip | xml_escape }}</content>
      {% if site.author %}
      <author>
          <name>{{ site.author.name | default: site.author | xml_escape }}</name>
        {% if site.author.email %}
          <email>{{ site.author.email | xml_escape }}</email>
        {% endif %}
      </author>
      {% endif %}
    </entry>

    {% elsif parts[1] == "project" %}
      {% assign project = site.data.projects[idx] %}
      {% capture project_content %}{{ project.description | markdownify }}{% endcapture %}
    <entry>
      <title type="html">{{ project.name | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      <link href="{{ project.url | xml_escape }}" rel="alternate" type="text/html" title="{{ project.name | xml_escape }}" />
      <id>{{ project.url | xml_escape }}</id>
      <published>{{ project.date | date_to_xmlschema }}</published>
      <updated>{{ project.date | date_to_xmlschema }}</updated>
      <category term="project" />
      <content type="html">{{ project_content | strip | xml_escape }}</content>
      {% if site.author %}
      <author>
          <name>{{ site.author.name | default: site.author | xml_escape }}</name>
        {% if site.author.email %}
          <email>{{ site.author.email | xml_escape }}</email>
        {% endif %}
      </author>
      {% endif %}
    </entry>
    {% endif %}
  {% endunless %}{% endfor %}
</feed>
