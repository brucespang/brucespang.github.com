@article{BLS2019,
  title = {Coded Trace Reconstruction in a Constant Number of Traces},
  author = {Brakensiek, Joshua and Li, Ray and Spang, Bruce},
  year = {2019},
  month = aug,
  journal = {arXiv:1908.03996 [cs, math]},
  eprint = {1908.03996},
  primaryclass = {cs, math},
  url = {arXiv,http://arxiv.org/abs/1908.03996},
  urldate = {2019-10-10},
  abstract = {The coded trace reconstruction problem asks to construct a code \$C\textbackslash subset \textbackslash\{0,1\textbackslash\}\^n\$ such that any \$x\textbackslash in C\$ is recoverable from independent outputs ("traces") of \$x\$ from a binary deletion channel (BDC). We present binary codes of rate \$1-\textbackslash varepsilon\$ that are efficiently recoverable from \$\textbackslash exp(O\_q(\textbackslash log\^\{1/3\}(1/\textbackslash varepsilon)))\$ (a constant independent of \$n\$) traces of a \$\textbackslash operatorname\{BDC\}\_q\$ for any constant deletion probability \$q\textbackslash in(0,1)\$. We also show that, for rate \$1-\textbackslash varepsilon\$ binary codes, \$\textbackslash tilde \textbackslash Omega(\textbackslash log\^\{5/2\}(1/\textbackslash varepsilon))\$ traces are required. The results follow from a pair of black-box reductions that show that average-case trace reconstruction is essentially equivalent to coded trace reconstruction. We also show that there exist codes of rate \$1-\textbackslash varepsilon\$ over an \$O\_\{\textbackslash varepsilon\}(1)\$-sized alphabet that are recoverable from \$O(\textbackslash log(1/\textbackslash varepsilon))\$ traces, and that this is tight.},
  archiveprefix = {arxiv},
  keywords = {Computer Science - Computational Complexity,Computer Science - Data Structures and Algorithms,Computer Science - Information Theory,Mathematics - Combinatorics},
  note = {Comment: 30 pages, 2 figures, comments welcome},
  file = {/Users/bspang/Zotero/storage/5N7CBNZG/Brakensiek et al_2019_Coded trace reconstruction in a constant number of traces.pdf;/Users/bspang/Zotero/storage/FNPUUU9R/1908.html}
}

